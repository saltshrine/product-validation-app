<main class="min-h-screen bg-white px-6 py-24 text-[#171717]">
  <div class="mx-auto max-w-xl">
    <p class="font-mono text-sm text-[#ff5b4f]">{{ error.code }}</p>
    <h1 class="mt-4 text-4xl font-semibold tracking-[-2.4px] [text-wrap:balance]">Something Went Wrong</h1>
    <p class="mt-4 text-[#666]">Coba lagi sebentar lagi atau kembali ke halaman produk.</p>
    <a href="/products" class="mt-8 inline-flex rounded-lg bg-[#171717] px-4 py-2.5 text-sm font-semibold text-white hover:bg-[#333] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0a72ef] focus-visible:ring-offset-2">Kembali ke Produk</a>
  </div>
</main>
