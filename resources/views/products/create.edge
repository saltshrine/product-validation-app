@layout('components/layout')

<div class="mx-auto mt-2 max-w-2xl rounded-xl bg-white p-6 shadow-[rgba(0,0,0,0.08)_0px_0px_0px_1px,rgba(0,0,0,0.04)_0px_2px_2px,#fafafa_0px_0px_0px_1px] sm:p-8">
  <div class="mb-8 pb-5 shadow-[rgba(0,0,0,0.08)_0px_1px_0px]">
    <h1 class="text-3xl font-semibold tracking-[-1.8px] text-[#171717] [text-wrap:balance]">Tambah & Validasi Produk</h1>
    <p class="mt-2 text-sm leading-6 text-[#666]">Bandingkan judul dan deskripsi untuk mendapatkan skor validasi.</p>
  </div>
  
  <form action="/products" method="POST" class="space-y-5">
    {{ csrfField() }}

    <!-- Pilihan Kategori -->
    <div>
      <label for="categoryId" class="mb-2 block text-sm font-medium text-[#171717]">Kategori</label>
      <select id="categoryId" name="categoryId" class="min-h-11 block w-full rounded-lg bg-[#fafafa] px-3 py-2.5 text-base text-[#171717] shadow-[rgba(0,0,0,0.08)_0px_0px_0px_1px,rgba(0,0,0,0.04)_0px_2px_2px,#fafafa_0px_0px_0px_1px] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0a72ef] focus-visible:ring-offset-2" required>
        <option value="" disabled selected>-- Pilih Kategori --</option>
        @each(category in categories)
          <option value="{{ category.id }}">{{ category.name }}</option>
        @end
      </select>
    </div>

    <!-- Input 1 -->
    <div>
      <label for="title" class="mb-2 block text-sm font-medium text-[#171717]">Title (Input 1)</label>
      <input id="title" type="text" name="title" class="min-h-11 mt-1 block w-full rounded-lg bg-white px-3 py-2.5 text-base text-[#171717] shadow-[rgba(0,0,0,0.08)_0px_0px_0px_1px,rgba(0,0,0,0.04)_0px_2px_2px,#fafafa_0px_0px_0px_1px] placeholder:text-[#999] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0a72ef] focus-visible:ring-offset-2" required placeholder="Contoh: ABBCD…">
    </div>

    <!-- Input 2 -->
    <div>
      <label for="description" class="mb-2 block text-sm font-medium text-[#171717]">Description (Input 2)</label>
      <textarea id="description" name="description" rows="3" class="mt-1 block w-full rounded-lg bg-white px-3 py-2.5 text-base text-[#171717] shadow-[rgba(0,0,0,0.08)_0px_0px_0px_1px,rgba(0,0,0,0.04)_0px_2px_2px,#fafafa_0px_0px_0px_1px] placeholder:text-[#999] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0a72ef] focus-visible:ring-offset-2" required placeholder="Contoh: Gallant Duck…"></textarea>
    </div>

    <!-- AJAX -->
    <div class="flex items-center justify-between rounded-lg bg-[#f5faff] p-4 shadow-[rgba(10,114,239,0.2)_0px_0px_0px_1px]" aria-live="polite">
      <span class="text-sm font-medium text-[#0759b8]">Live score</span>
      <span id="ajax-live-score" class="font-mono text-lg font-semibold tabular-nums text-[#0a72ef]">0%</span>
    </div>

    <!-- Tipe Pengecekan Algoritma (Sensitive / Non-Sensitive) -->
    <div>
      <label for="checkType" class="mb-2 block text-sm font-medium text-[#171717]">Tipe Pengecekan</label>
      <select id="checkType" name="checkType" class="min-h-11 block w-full rounded-lg bg-[#f5faff] px-3 py-2.5 text-base font-medium text-[#0759b8] shadow-[rgba(10,114,239,0.2)_0px_0px_0px_1px] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0a72ef] focus-visible:ring-offset-2" required>
        <option value="sensitive">Sensitive Case</option>
        <option value="non-sensitive">Non-Sensitive Case</option>
      </select>
    </div>

    <!-- Harga & Stok -->
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
      <div>
        <label for="price" class="mb-2 block text-sm font-medium text-[#171717]">Harga (Rp)</label>
        <input id="price" type="number" name="price" min="0" class="min-h-11 block w-full rounded-lg bg-white px-3 py-2.5 text-base tabular-nums text-[#171717] shadow-[rgba(0,0,0,0.08)_0px_0px_0px_1px,rgba(0,0,0,0.04)_0px_2px_2px,#fafafa_0px_0px_0px_1px] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0a72ef] focus-visible:ring-offset-2" required placeholder="0">
      </div>
      <div>
        <label for="stock" class="mb-2 block text-sm font-medium text-[#171717]">Stok</label>
        <input id="stock" type="number" name="stock" min="0" class="min-h-11 block w-full rounded-lg bg-white px-3 py-2.5 text-base tabular-nums text-[#171717] shadow-[rgba(0,0,0,0.08)_0px_0px_0px_1px,rgba(0,0,0,0.04)_0px_2px_2px,#fafafa_0px_0px_0px_1px] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0a72ef] focus-visible:ring-offset-2" required placeholder="0">
      </div>
    </div>

    <!-- Tombol Submit -->
    <div class="pt-3">
      <button type="submit" class="min-h-11 w-full rounded-lg bg-[#171717] px-4 py-3 text-sm font-semibold text-white transition-colors hover:bg-[#333] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0a72ef] focus-visible:ring-offset-2">
        Hitung Validasi & Simpan Produk
      </button>
    </div>
  </form>
</div>


<script>
  const titleInput = document.querySelector('input[name="title"]');
  const descInput = document.querySelector('textarea[name="description"]');
  const typeSelect = document.querySelector('select[name="checkType"]');
  const scoreBadge = document.getElementById('ajax-live-score');

  async function fetchLiveScore() {
    const title = titleInput.value;
    const description = descInput.value;
    const checkType = typeSelect.value;

    if (title.length === 0) {
      scoreBadge.innerText = '0%';
      return;
    }

    try {
      // Mengirim request POST secara asinkron ke backend AdonisJS
      const response = await fetch('/api/check-similarity', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-TOKEN': '{{ csrfToken }}' // Token keamanan CSRF Adonis
        },
        body: JSON.stringify({ title, description, checkType })
      });

      const data = await response.json();
      scoreBadge.innerText = `${data.percentage}% (Match: ${data.matchCount}/${data.totalChars})`;
    } catch (error) {
      console.error('Gagal mengambil data AJAX:', error);
    }
  }

  // Memicu fungsi AJAX saat user mengetik atau mengubah pilihan
  titleInput.addEventListener('input', fetchLiveScore);
  descInput.addEventListener('input', fetchLiveScore);
  typeSelect.addEventListener('change', fetchLiveScore);
</script>

@end