@layout('components/layout')

<div class="mx-auto max-w-6xl space-y-10 py-2">
  
  <div>
    <h1 class="mb-5 text-3xl font-semibold tracking-[-1.8px] text-[#171717] [text-wrap:balance]">Laporan Ringkasan Validasi</h1>
    
    <!-- Kotak Kartu Statistik (Diubah menjadi 5 Kolom / Responsive) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-5 gap-4">
      
      <!-- Total Produk -->
      <div class="rounded-xl bg-white p-4 shadow-[rgba(0,0,0,0.08)_0px_0px_0px_1px,rgba(0,0,0,0.04)_0px_2px_2px,#fafafa_0px_0px_0px_1px]">
        <p class="text-xs font-semibold text-gray-500 uppercase">Total Diuji</p>
        <p class="mt-1 font-mono text-2xl font-semibold tabular-nums text-[#171717]">{{ report.totalProducts }}</p>
      </div>

      <!-- Approved -->
      <div class="rounded-xl bg-white p-4 shadow-[rgba(0,0,0,0.08)_0px_0px_0px_1px,rgba(0,0,0,0.04)_0px_2px_2px,#fafafa_0px_0px_0px_1px]">
        <p class="text-xs font-semibold uppercase text-[#15803d]">Approved</p>
        <p class="mt-1 font-mono text-2xl font-semibold tabular-nums text-[#15803d]">{{ report.totalAman }} <span class="font-sans text-xs font-normal text-[#666]">({{ report.successRate }}%)</span></p>
      </div>

      <!-- Pending -->
      <div class="rounded-xl bg-white p-4 shadow-[rgba(0,0,0,0.08)_0px_0px_0px_1px,rgba(0,0,0,0.04)_0px_2px_2px,#fafafa_0px_0px_0px_1px]">
        <p class="text-xs font-semibold uppercase text-[#b45309]">Pending</p>
        <p class="mt-1 font-mono text-2xl font-semibold tabular-nums text-[#b45309]">{{ report.totalReview }}</p>
      </div>

      <!-- Rejected -->
      <div class="rounded-xl bg-white p-4 shadow-[rgba(0,0,0,0.08)_0px_0px_0px_1px,rgba(0,0,0,0.04)_0px_2px_2px,#fafafa_0px_0px_0px_1px]">
        <p class="text-xs font-semibold uppercase text-[#c2413a]">Rejected</p>
        <p class="mt-1 font-mono text-2xl font-semibold tabular-nums text-[#c2413a]">{{ report.totalDitolak }}</p>
      </div>

      <!-- Rata-rata Skor -->
      <div class="rounded-xl bg-white p-4 shadow-[rgba(0,0,0,0.08)_0px_0px_0px_1px,rgba(0,0,0,0.04)_0px_2px_2px,#fafafa_0px_0px_0px_1px]">
        <p class="text-xs font-semibold uppercase text-[#0a72ef]">Rata-rata Skor</p>
        <p class="mt-1 font-mono text-2xl font-semibold tabular-nums text-[#0a72ef]">{{ report.avgScore }}%</p>
      </div>

    </div>
  </div>

  <!-- BAGIAN 2: DAFTAR PRODUK & TOMBOL TAMBAH (Sejajar) -->
  <div>
    <div class="flex justify-between items-center mb-4">
      <h2 class="text-xl font-bold text-gray-800">Daftar Produk</h2>
      <a href="/products/create" class="rounded-lg bg-[#171717] px-4 py-2.5 text-sm font-semibold text-white shadow-[rgba(0,0,0,0.16)_0px_2px_4px] transition-colors hover:bg-[#333] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0a72ef] focus-visible:ring-offset-2">Tambah Produk</a>
    </div>

    <!-- Tabel Daftar Produk -->
    <div class="overflow-hidden rounded-xl bg-white shadow-[rgba(0,0,0,0.08)_0px_0px_0px_1px,rgba(0,0,0,0.04)_0px_2px_2px,#fafafa_0px_0px_0px_1px]">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-[#fafafa]">
          <tr class="text-xs uppercase tracking-wide text-[#666]">
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Judul & Kategori</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Skor (Sens / Non-Sens)</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status Validasi</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Aksi</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 bg-white">
          @if(products.length === 0)
            <tr>
              <td colspan="4" class="px-6 py-4 text-center text-gray-500 text-sm">Belum ada data produk yang diinput.</td>
            </tr>
          @else
            @each(product in products)
              <tr>
                <td class="px-6 py-4">
                  <div class="text-sm font-semibold text-[#171717]">{{ product.title }}</div>
                  <div class="text-xs text-gray-500">{{ product.category ? product.category.name : '-' }}</div>
                </td>
                <td class="px-6 py-4 text-sm font-semibold text-gray-700">
                  {{ product.scoreSensitive }}% / {{ product.scoreNonSensitive }}%
                </td>
                <td class="px-6 py-4">
                  <span class="rounded-full px-2.5 py-1 text-xs font-semibold {{ product.statusReview == 'approved' ? 'bg-[#ecfdf3] text-[#15803d] shadow-[rgba(22,163,74,0.2)_0px_0px_0px_1px]' : (product.statusReview == 'pending' ? 'bg-[#fff8eb] text-[#b45309] shadow-[rgba(245,158,11,0.22)_0px_0px_0px_1px]' : 'bg-[#fff1f0] text-[#c2413a] shadow-[rgba(255,91,79,0.25)_0px_0px_0px_1px]') }}">
                    {{ product.statusReview == 'approved' ? 'Approved' : (product.statusReview == 'pending' ? 'Pending' : 'Rejected') }}
                  </span>
                </td>
                <td class="px-6 py-4 text-sm space-x-2 flex items-center">
                  <a href="/products/{{ product.id }}" class="font-medium text-[#0a72ef] hover:text-[#0759b8] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0a72ef]">Detail</a>
                  <span class="text-gray-300">|</span>
                  <a href="/products/{{ product.id }}/edit" class="font-medium text-[#0a72ef] hover:text-[#0759b8] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0a72ef]">Edit</a>
                  <span class="text-gray-300">|</span>
                  <form action="/products/{{ product.id }}/delete" method="POST" class="inline" onsubmit="return confirm('Yakin ingin menghapus produk ini?')">
                    {{ csrfField() }}
                    <button type="submit" class="text-red-600 hover:text-red-900 font-medium">Hapus</button>
                  </form>
                </td>
              </tr>
            @end
          @end
        </tbody>
      </table>
    </div>
  </div>

</div>

@end